# Local testing settings for docker-compose.yml. Git-ignored; do not commit.

# Published image. Use the default, or a local build:
#   docker build -t webtor-self-hosted:assembly .
#   WEBTOR_IMAGE=webtor-self-hosted:assembly
WEBTOR_IMAGE=ghcr.io/webtor-io/self-hosted:latest

# Host port. Change it if 8080 is taken by another dev server.
WEBTOR_PORT=8080
DOMAIN=http://localhost:8080

# Test-only admin password. Replace it before exposing this instance.
ADMIN_PASSWORD=test-admin-123

# Generated for this test setup. Keep it: losing it makes stored private
# torrent records unreadable.
PRIVATE_TRACKERS_KEY=d00e62be9804cfd27943ae04c994163baa1bb5b8102287df95f62fba74ed9811

# Empty: the container generates the S3 credentials on first start.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
